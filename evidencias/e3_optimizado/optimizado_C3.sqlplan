<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT r.Origen, r.Destino, MONTH(b.FechaVenta) AS Mes, COUNT(*) AS Boletos, SUM(p.Monto) AS Ingresos&#xa;FROM dbo.Boletos b&#xa;JOIN dbo.Pagos  p ON p.BoletoID = b.BoletoID&#xa;JOIN dbo.Viajes v ON v.ViajeID  = b.ViajeID&#xa;JOIN dbo.Rutas  r ON r.RutaID   = v.RutaID&#xa;WHERE b.FechaVenta &gt;= &apos;2025-01-01&apos; AND b.FechaVenta &lt; &apos;2026-01-01&apos; AND b.Estado = &apos;Activo&apos;&#xa;GROUP BY r.Origen, r.Destino, MONTH(b.FechaVenta)&#xa;ORDER BY r.Origen, r.Destino, Mes&#xa;OPTION (RECOMPILE)" StatementId="1" StatementCompId="8" StatementType="SELECT" StatementSqlHandle="0x090009552DA8466F1A06E11D136061E95FBC0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="3.51594" StatementEstRows="235.662" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x68462EA126495BB8" QueryPlanHash="0xC63EAC13B23FD48B" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="75928" CachedPlanSize="128" CompileTime="15" CompileCPU="15" CompileMemory="1840"><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="75928" GrantedMemory="75928" MaxUsedMemory="2120"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="75928" RequiredMemory="5272" DesiredMemory="75928" RequestedMemory="75928" GrantWaitTime="0" MaxQueryMemory="2528832" GrantedMemory="75928" MaxUsedMemory="2120" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted